local function startSpectate(targetName)
    if spectateConnection then spectateConnection:Disconnect(); spectateConnection = nil end
    local target = Players:FindFirstChild(targetName)
    if not target or not target.Character then return end
    local h = target.Character:FindFirstChildOfClass("Humanoid")
    if not h then return end
    workspace.CurrentCamera.CameraSubject = h
    spectateConnection = RunService.RenderStepped:Connect(function()
        if target and target.Character then
            local hh = target.Character:FindFirstChildOfClass("Humanoid")
            if hh and hh.Health > 0 then workspace.CurrentCamera.CameraSubject = hh end
        end
    end)
end


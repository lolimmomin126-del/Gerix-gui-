            TweenService:Create(BarGlow, TweenInfo.new(0.35), { BackgroundTransparency = 1 }):Play()

            task.wait(0.35)

            FinalText.TextTransparency = 1
            FinalText.TextStrokeTransparency = 1

            local uiScale = Instance.new("UIScale")

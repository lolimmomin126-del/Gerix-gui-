    if Input.UserInputType ~= Enum.UserInputType.MouseButton1 and Input.UserInputType ~= Enum.UserInputType.Touch then return end
    if FastSwitchHoldMode then
        getgenv().ToggleGunSwitch(true); updateFastSwitchButtonVisual()
        local Changed
        Changed = Input.Changed:Connect(function()
            if Input.UserInputState ~= Enum.UserInputState.End and Input.UserInputState ~= Enum.UserInputState.Cancel then return end
            getgenv().ToggleGunSwitch(false); updateFastSwitchButtonVisual()
            if Changed and Changed.Connected then Changed:Disconnect(); Changed = nil end
        end)

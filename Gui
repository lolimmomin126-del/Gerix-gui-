local function WipeFolder(folder)
    if not (listfiles and delfile) then return end
    local function wipe(path)
        pcall(function()
            if isfolder and not isfolder(path) then return end
            for _, item in ipairs(listfiles(path)) do
                if isfolder and isfolder(item) then wipe(item) else pcall(delfile, item) end
            end
        end)
    end
    wipe(folder)
end


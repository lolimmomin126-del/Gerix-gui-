                TextStrokeTransparency = 0.4,
            }):Play()
            TweenService:Create(uiScale, TweenInfo.new(0.7, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
                Scale = 1,
            }):Play()

            task.spawn(function()
                local t = 0
                while FinalText.Parent and FinalText.TextTransparency < 0.5 do
                    t = (t + 0.02) % 1
                    FinalGradient.Offset = Vector2.new(t, 0)
                    task.wait(0.03)
                end
            end)

            task.spawn(function()
                for i = 1, 28 do
                    if not FinalText.Parent then return end
                    local sparkle = Instance.new("Frame")
                    local ss = s(math.random(6, 12))
                    sparkle.Size = UDim2.fromOffset(ss, ss)
                    sparkle.Position = UDim2.new(math.random(), 0, 0.5 + (math.random(-20, 20) / 100), 0)
                    sparkle.BackgroundColor3 = Color3.fromRGB(200, 220, 255)
                    sparkle.BorderSizePixel = 0
                    sparkle.ZIndex = 41
                    sparkle.Parent = Background

                    local sc = Instance.new("UICorner")
                    sc.CornerRadius = UDim.new(1, 0)
                    sc.Parent = sparkle

                    TweenService:Create(sparkle, TweenInfo.new(1.2), {
                        Position = sparkle.Position + UDim2.fromOffset(0, -s(50)),
                        BackgroundTransparency = 1,
                        Size = UDim2.fromOffset(1, 1),
                    }):Play()
                    task.delay(1.3, function()
                        if sparkle and sparkle.Parent then sparkle:Destroy() end
                    end)
                    task.wait(0.06)
                end
            end)

            task.wait(0.25)
            burst(0.5, 0.5, 30, Color3.fromRGB(150, 200, 255))
            burst(0.5, 0.5, 20, Color3.fromRGB(200, 150, 255))

            task.wait(1.9)
        end)

        TweenService:Create(Root, TweenInfo.new(0.7, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
            GroupTransparency = 1,
        }):Play()
        task.wait(0.8)

        if LoaderGui and LoaderGui.Parent then
            LoaderGui:Destroy()
        end

        getgenv().GerixLoaderDone = true
    end)

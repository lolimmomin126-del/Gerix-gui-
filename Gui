            task.wait(0.15)
            TweenService:Create(flash, TweenInfo.new(0.5), { BackgroundTransparency = 1 }):Play()

            burst(0.5, 0.5, 50, Color3.fromRGB(150, 200, 255))
            burst(0.5, 0.5, 40, Color3.fromRGB(200, 150, 255))
            burst(0.5, 0.5, 40, Color3.fromRGB(150, 255, 220))

            local origPos = Background.Position
            for i = 1, 8 do
                Background.Position = origPos + UDim2.fromOffset(math.random(-6, 6), math.random(-6, 6))
                task.wait(0.03)
            end
            Background.Position = origPos
            task.wait(0.35)

            for _, el in ipairs({Title, Subtitle, PercentText, StatusText}) do
                TweenService:Create(el, TweenInfo.new(0.35), { TextTransparency = 1 }):Play()
            end
            TweenService:Create(TitleStroke, TweenInfo.new(0.35), { Transparency = 1 }):Play()
            TweenService:Create(BarContainer, TweenInfo.new(0.35), { BackgroundTransparency = 1 }):Play()
            TweenService:Create(bs, TweenInfo.new(0.35), { Transparency = 1 }):Play()
